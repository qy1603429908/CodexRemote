CMR_HOST=127.0.0.1
CMR_PORT=8787
CMR_TOKEN=replace-with-at-least-32-random-characters
# CMR_ALLOWED_ORIGINS=capacitor://localhost,http://localhost
# CODEX_BIN=/opt/homebrew/bin/codex
# CODEX_HOME=/Users/you/.codex
# Windows example: CODEX_HOME=C:\Users\you\.codex

# Desktop IPC is enabled by default. Windows defaults to \\.\pipe\codex-ipc.
# CMR_DESKTOP_IPC=0
# CMR_DESKTOP_IPC_ENDPOINT=\\.\pipe\codex-ipc
